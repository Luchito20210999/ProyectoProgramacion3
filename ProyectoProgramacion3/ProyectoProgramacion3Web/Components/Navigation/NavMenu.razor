@namespace ProyectoProgramacion3Web.Components.Navigation

<div class="nav-sidebar">
    <div class="nav-brand">
        <div class="nav-logo-icon">S</div>
        <span class="nav-logo-text">SACR</span>
    </div>
    
    <nav class="nav-menu">
        @if (MenuGroups != null)
        {
            @foreach (var group in MenuGroups)
            {
                <div class="nav-group">
                    <span class="nav-group-title">@group.Title</span>
                    <ul class="nav-list">
                        @foreach (var item in group.Items)
                        {
                            <li class="nav-item">
                                @if (item.Url == "logout")
                                {
                                    <button class="nav-link btn-logout-nav" @onclick="SolicitarCerrarSesion">
                                        <span class="nav-icon">@item.Icon</span>
                                        <span class="nav-text">@item.Text</span>
                                    </button>
                                }
                                else
                                {
                                    <NavLink class="nav-link" href="@item.Url" Match="NavLinkMatch.All">
                                        <span class="nav-icon">@item.Icon</span>
                                        <span class="nav-text">@item.Text</span>
                                    </NavLink>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </nav>
</div>

<!-- Modal de Confirmación de Cierre de Sesión (Estilo Crítico) -->
@if (IsConfirmOpen)
{
    <div class="logout-backdrop">
        <div class="logout-modal-window critical-confirm">
            <div class="logout-modal-header danger-header">
                <h3>Cerrar sesión</h3>
            </div>
            <div class="logout-modal-body">
                <p class="critical-text">¿Deseas cerrar sesión del sistema SACR?</p>
                <p style="margin-top: 0.5rem; font-size: 0.88rem; color: #64748b;">Perderás los cambios no guardados y tendrás que volver a autenticarte para operar.</p>
            </div>
            <div class="logout-modal-footer">
                <button class="btn-logout-modal btn-cancel-action" @onclick="CancelarCerrarSesion">Cancelar</button>
                <button class="btn-logout-modal btn-danger-action" @onclick="AceptarCerrarSesion">Cerrar sesión</button>
            </div>
        </div>
    </div>
}
