@inherits LayoutComponentBase
@namespace ProyectoProgramacion3Web.Components.Layout
@using ProyectoProgramacion3Web.Components.Navigation

<div class="app-container">
    <NavMenu />
    
    <div class="content-container">
        @if (IsPageLoading)
        {
            <div class="page-loading-overlay" aria-live="polite" aria-label="Cargando">
                <div class="page-loading-card">
                    <span class="page-spinner"></span>
                    <span>Cargando...</span>
                </div>
            </div>
        }

        <header class="top-bar">
            <div class="top-bar-user">
                <span class="user-role">@Session.Role</span>
                <div class="user-avatar" title="@Session.Username">
                    @Session.Initials
                </div>
            </div>
        </header>
        
        <main class="page-body">
            @if (CanRenderBody)
            {
                @Body
            }
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
