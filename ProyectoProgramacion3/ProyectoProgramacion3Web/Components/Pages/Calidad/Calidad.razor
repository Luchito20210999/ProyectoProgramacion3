@page "/calidad"
@namespace ProyectoProgramacion3Web.Components.Pages.Calidad

<PageTitle>Reporte de Calidad - SACR</PageTitle>

<div class="calidad-container">
    <!-- Encabezado de la página -->
    <div class="calidad-header no-print">
        <div class="header-titles">
            <h1 class="calidad-title">Reporte de Calidad</h1>
            <p class="calidad-subtitle">Indicadores de incidencias y atención de reclamos.</p>
        </div>
        <div class="header-actions">
            <!-- Botón Generar (principal primario) -->
            <button class="btn btn-primary" @onclick="GenerarReporte">
                Generar reporte
            </button>
        </div>
    </div>
    
    <!-- Cabecera exclusiva para Impresión PDF -->
    <div class="print-only-header">
        <h2>REPORTE DE CALIDAD OPERATIVA - SACR</h2>
        <p>Generado automáticamente el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        @if (FechaInicio.HasValue || FechaFin.HasValue || ServicioSeleccionado != "Todos")
        {
            <p class="print-filters">
                Filtros aplicados: 
                @(ServicioSeleccionado != "Todos" ? $"Servicio: {ServicioSeleccionado} | " : "")
                Periodo: @(FechaInicio.HasValue ? FechaInicio.Value.ToString("dd/MM/yyyy") : "Inicio") al @(FechaFin.HasValue ? FechaFin.Value.ToString("dd/MM/yyyy") : "Fin")
            </p>
        }
    </div>
    
    <!-- Bloque de filtros -->
    <div class="filters-card no-print">
        <div class="filters-grid">
            <div class="filter-group">
                <label for="calidad-fecha-inicio">Fecha inicio</label>
                <input id="calidad-fecha-inicio" class="input-control" type="date" @bind="FechaInicio" @bind:after="FiltrarDatos" />
            </div>
            
            <div class="filter-group">
                <label for="calidad-fecha-fin">Fecha fin</label>
                <input id="calidad-fecha-fin" class="input-control" type="date" @bind="FechaFin" @bind:after="FiltrarDatos" />
            </div>
            
            <div class="filter-group">
                <label for="calidad-filtro-servicio">Servicio</label>
                <select id="calidad-filtro-servicio" class="select-control" @bind="ServicioSeleccionado" @bind:after="FiltrarDatos">
                    <option value="Todos">Todos</option>
                    @foreach (var servicio in ServiciosDisponibles)
                    {
                        <option value="@servicio">@servicio</option>
                    }
                </select>
            </div>
        </div>
    </div>
    
    <!-- Cuadrícula de métricas KPI -->
    <div class="metrics-grid">
        <!-- Reservas en periodo -->
        <div class="metric-card">
            <span class="metric-label">Reservas en periodo</span>
            <span class="metric-value">@ReservasCount</span>
            <div class="metric-delta">
                <span class="delta-trend text-green">▲ +12.4%</span>
                <span class="delta-label">vs periodo ant.</span>
            </div>
        </div>
        
        <!-- Reclamos recibidos -->
        <div class="metric-card">
            <span class="metric-label">Reclamos recibidos</span>
            <span class="metric-value">@ReclamosCount</span>
            <div class="metric-delta">
                <span class="delta-trend text-green">▼ -4.3%</span>
                <span class="delta-label">de mejora</span>
            </div>
        </div>
        
        <!-- % Incidencias -->
        <div class="metric-card">
            <span class="metric-label">% Incidencias</span>
            <span class="metric-value">@IncidenciasRate.ToString("F1")%</span>
            <div class="metric-delta">
                <span class="delta-trend text-green">▼ -1.5%</span>
                <span class="delta-label">reducción tasa</span>
            </div>
        </div>
        
        <!-- Tiempo prom. atención -->
        <div class="metric-card">
            <span class="metric-label">Tiempo prom. atención</span>
            <span class="metric-value">@TiempoPromedioAtencion.ToString("F1") d</span>
            <div class="metric-delta">
                <span class="delta-trend text-green">▼ -0.3 d</span>
                <span class="delta-label">de rapidez</span>
            </div>
        </div>
    </div>
    
    <!-- Zona analítica -->
    <div class="analytics-grid">
        <!-- Columna izquierda: Procedencia de reclamos (Progress Bars) -->
        <div class="analysis-card">
            <div class="card-header">
                <div class="card-title-group">
                    <h3>Procedencia de reclamos</h3>
                    <p class="card-subtitle-small">Distribución de dictámenes e incidencias del periodo</p>
                </div>
            </div>
            
            <div class="progress-bars-container">
                <!-- Procede -->
                <div class="progress-bar-row">
                    <div class="progress-info">
                        <span class="progress-label font-bold text-dark">Procede</span>
                        <div class="progress-values">
                            <span class="absolute-val font-semibold">@ProcedeCount</span>
                            <span class="percentage-val text-muted">(@ProcedePercent.ToString("F1")%)</span>
                        </div>
                    </div>
                    <div class="progress-track">
                        <div class="progress-fill fill-green" style="width: @(ProcedePercent.ToString("F1"))%;"></div>
                    </div>
                </div>
                
                <!-- No procede -->
                <div class="progress-bar-row">
                    <div class="progress-info">
                        <span class="progress-label font-bold text-dark">No procede</span>
                        <div class="progress-values">
                            <span class="absolute-val font-semibold">@NoProcedeCount</span>
                            <span class="percentage-val text-muted">(@NoProcedePercent.ToString("F1")%)</span>
                        </div>
                    </div>
                    <div class="progress-track">
                        <div class="progress-fill fill-red" style="width: @(NoProcedePercent.ToString("F1"))%;"></div>
                    </div>
                </div>
                
                <!-- Pendientes / En atención -->
                <div class="progress-bar-row">
                    <div class="progress-info">
                        <span class="progress-label font-bold text-dark">Pendientes</span>
                        <div class="progress-values">
                            <span class="absolute-val font-semibold">@PendientesCount</span>
                            <span class="percentage-val text-muted">(@PendientesPercent.ToString("F1")%)</span>
                        </div>
                    </div>
                    <div class="progress-track">
                        <div class="progress-fill fill-yellow" style="width: @(PendientesPercent.ToString("F1"))%;"></div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Columna derecha: Reclamos por servicio -->
        <div class="analysis-card">
            <div class="card-header">
                <div class="card-title-group">
                    <h3>Reclamos por servicio</h3>
                    <p class="card-subtitle-small">Cantidad de incidencias operativas registradas</p>
                </div>
                <span class="currency-tag">Alertas</span>
            </div>
            
            <div class="chart-outer-frame">
                <!-- Eje Y de ticks -->
                <div class="chart-y-axis">
                    <span class="axis-tick">@((MaxReclamosCount).ToString("F0"))</span>
                    <span class="axis-tick">@((MaxReclamosCount * 0.75).ToString("F0"))</span>
                    <span class="axis-tick">@((MaxReclamosCount * 0.5).ToString("F0"))</span>
                    <span class="axis-tick">@((MaxReclamosCount * 0.25).ToString("F0"))</span>
                    <span class="axis-tick">0</span>
                </div>
                
                <!-- Contenedor del gráfico y las barras -->
                <div class="bar-chart-container">
                    <div class="chart-grid-lines">
                        <div class="grid-line"></div>
                        <div class="grid-line"></div>
                        <div class="grid-line"></div>
                        <div class="grid-line"></div>
                        <div class="grid-line"></div>
                    </div>
                    
                    <div class="bar-chart">
                        @if (ReclamosPorServicio != null && ReclamosPorServicio.Any())
                        {
                            var maxCount = ReclamosPorServicio.Max(v => v.Cantidad);
                            @foreach (var item in ReclamosPorServicio)
                            {
                                <div class="bar-column">
                                    <!-- Tooltip al pasar el ratón -->
                                    <div class="bar-value-tooltip">@item.Cantidad reclamos</div>
                                    
                                    <!-- Barra vertical -->
                                    <div class="bar-wrapper">
                                        <div class="bar-fill @(item.Cantidad == maxCount && maxCount > 0 ? "max-value" : "")" 
                                             style="height: @(item.PorcentajeAltura.ToString("F1"))%;">
                                        </div>
                                    </div>
                                    
                                    <!-- Etiqueta debajo -->
                                    <span class="bar-label" title="@item.Servicio">@item.ServicioCorto</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Tabla de detalle transaccional -->
    <div class="detail-card page-break">
        <div class="card-header">
            <div class="card-title-group">
                <h3>Detalle</h3>
                <p class="card-subtitle-small">Registro individual y dictamen técnico de calidad por reclamo</p>
            </div>
            <span class="rows-count-badge">@ListadoFiltrado.Count incidencias</span>
        </div>
        
        <div class="table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 50px;">N°</th>
                        <th style="width: 110px;">Reserva</th>
                        <th>Servicio</th>
                        <th class="text-center" style="width: 120px;">Fecha</th>
                        <th class="text-center" style="width: 130px;">Procedencia</th>
                        <th>Resolución / Motivo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ListadoFiltrado != null && ListadoFiltrado.Any())
                    {
                        var correlative = 1;
                        @foreach (var rec in ListadoFiltrado)
                        {
                            <tr>
                                <td class="text-center font-mono text-muted">@correlative</td>
                                <td class="booking-code">@rec.CodigoReserva</td>
                                <td class="service-name-row">@rec.Servicio</td>
                                <td class="text-center text-muted">@rec.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <span class="status-pill @rec.ProcedenciaClase">@rec.Procedencia</span>
                                </td>
                                <td class="resolution-text">@rec.Resolucion</td>
                            </tr>
                            correlative++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-8">
                                <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🔍</div>
                                No se encontraron incidencias de calidad en este periodo.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

