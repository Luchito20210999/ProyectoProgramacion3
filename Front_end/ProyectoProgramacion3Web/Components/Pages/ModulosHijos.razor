@namespace ProyectoProgramacion3Web.Components.Pages

<PageTitle>@ModuleName - SACR</PageTitle>

<div style="padding: 3rem; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; box-sizing: border-box;">
    <h1 style="font-size: 2.25rem; font-weight: 800; color: #0f172a; margin: 0 0 0.25rem 0; letter-spacing: -0.02em;">@ModuleName</h1>
    <p style="color: #64748b; font-size: 0.95rem; margin: 0 0 2rem 0;">Módulo del Sistema de Atención de Clientes y Reservas (SACR)</p>
    
    <div style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; padding: 4rem 3rem; text-align: center; box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.02); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem;">
        <div style="font-size: 3.5rem; line-height: 1;">⚙️</div>
        <h3 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0;">Módulo en Desarrollo</h3>
        <p style="color: #64748b; max-width: 420px; margin: 0; font-size: 0.95rem; line-height: 1.6;">Estamos trabajando en la implementación y conectividad de datos para la sección de <strong>@ModuleName</strong>. Esta característica estará disponible próximamente.</p>
    </div>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; }

    public string ModuleName
    {
        get
        {
            var uri = new Uri(Navigation.Uri);
            var path = uri.AbsolutePath.Trim('/');
            if (string.IsNullOrEmpty(path)) return "Módulo";
            
            // Retorna con primera letra en mayúscula
            return char.ToUpper(path[0]) + path.Substring(1);
        }
    }
}
