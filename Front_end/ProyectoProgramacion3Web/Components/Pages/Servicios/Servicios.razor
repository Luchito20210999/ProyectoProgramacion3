@page "/servicios"
@namespace ProyectoProgramacion3Web.Components.Pages.Servicios

<PageTitle>Catálogo de Servicios - SACR</PageTitle>

<div class="servicios-container">
    <!-- Encabezado de la página -->
    <div class="servicios-header">
        <div class="header-titles">
            <h1 class="servicios-title">Catálogo de Servicios</h1>
            <p class="servicios-subtitle">Tours y experiencias ofrecidas.</p>
        </div>
        <div class="header-actions">
            <button class="btn btn-primary" @onclick='() => AbrirModal("Nuevo")'>
                <span class="btn-icon">＋</span> Nuevo servicio
            </button>
        </div>
    </div>
    
    <!-- Catálogo en grilla responsive de tarjetas -->
    @if (ListadoServicios != null && ListadoServicios.Any())
    {
        <div class="services-grid">
            @foreach (var srv in ListadoServicios)
            {
                <div class="service-card">
                    <!-- Cabecera visual de cada tarjeta -->
                    <div class="service-cover" style="background-image: linear-gradient(rgba(15, 23, 42, 0.35), rgba(15, 23, 42, 0.6)), url('@ObtenerImagenDestinoUrl(srv.CiudadDestino)');">
                        <!--<span class="cover-icon">@srv.Icono</span>-->
                    </div>
                    
                    <!-- Contenido interno de la tarjeta -->
                    <div class="service-body">
                        <!-- Título y Precio -->
                        <div class="service-title-row">
                            <h3 class="service-title" title="@srv.Nombre">@srv.Nombre</h3>
                            <span class="price-badge">$ @srv.Precio.ToString("N0")</span>
                        </div>
                        
                        <!-- Descripción -->
                        <p class="service-desc">@srv.Descripcion</p>
                        
                        <!-- Chips informativos -->
                        <div class="service-chips">
                            <span class="service-chip" title="Ciudad destino">📍 @srv.CiudadDestino</span>
                            <span class="service-chip" title="Duración">⏱ @srv.Duracion h</span>
                            <span class="service-chip" title="Capacidad máxima">👥 @srv.CapacidadMaxima pax</span>
                            <span class="service-chip" title="Idioma del guía">Aあ @srv.IdiomaGuia</span>
                            <span class="service-chip" title="Servicio de recojo">🚐 @(srv.IncluyeRecojo == "Sí" ? "Incluye recojo" : "No incluye recojo")</span>
                        </div>
                        
                        <!-- Botones de acción -->
                        <div class="service-actions">
                            <button class="btn-row btn-row-edit" @onclick='() => AbrirModal("Editar", srv)'>Editar</button>
                            <button class="btn-row btn-row-delete" @onclick="() => EliminarServicio(srv)">Eliminar</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state-card">
            <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">🧭</div>
            <h3>No hay servicios registrados</h3>
            <p>El catálogo se encuentra vacío. Haz clic en "Nuevo servicio" en la parte superior para añadir tu primera experiencia.</p>
        </div>
    }
    
    <!-- Modal emergente para Servicio (Crear/Editar) -->
    @if (IsModalOpen)
    {
        <div class="modal-backdrop">
            <div class="modal-window">
                <div class="modal-header">
                    <h2>@ModalTitle</h2>
                    <button class="modal-close-btn" @onclick="CerrarModal">×</button>
                </div>
                
                <div class="modal-body">
                    <form @onsubmit="GuardarServicio" @onsubmit:preventDefault @onclick="CerrarDropdownIdioma">
                        <div class="modal-grid">
                            <!-- Nombre -->
                            <div class="modal-group">
                                <label for="modal-nombre">Nombre</label>
                                <input id="modal-nombre" class="modal-input" type="text" 
                                       @bind="FormServicio.Nombre" required placeholder="Ej. Machu Picchu Mágico" />
                            </div>
                            
                            <!-- Precio (USD) -->
                            <div class="modal-group">
                                <label for="modal-precio">Precio (USD)</label>
                                <input id="modal-precio" class="modal-input" type="number" min="1" step="0.01"
                                       @bind="FormServicio.Precio" required placeholder="Ej. 120" />
                            </div>
                            
                            <!-- Descripción (ocupa toda la fila en el grid del modal) -->
                            <div class="modal-group full-width">
                                <label for="modal-descripcion">Descripción</label>
                                <input id="modal-descripcion" class="modal-input" type="text" 
                                       @bind="FormServicio.Descripcion" required placeholder="Resumen corto de la experiencia turística" />
                            </div>
                            
                            <!-- Duración (h) -->
                            <div class="modal-group">
                                <label for="modal-duracion">Duración (h)</label>
                                <input id="modal-duracion" class="modal-input" type="number" min="1" 
                                       @bind="FormServicio.Duracion" required placeholder="Ej. 4" />
                            </div>
                            
                            <!-- Capacidad Máxima -->
                            <div class="modal-group">
                                <label for="modal-capacidad">Capacidad máxima</label>
                                <input id="modal-capacidad" class="modal-input" type="number" min="1" 
                                       @bind="FormServicio.CapacidadMaxima" required placeholder="Ej. 15" />
                            </div>
                            
                            <!-- Idioma del Guía -->
                            <div class="modal-group">
                                <label>Idioma del guía</label>
                                <div class="custom-multiselect" @onclick:stopPropagation>
                                    <div class="multiselect-toggle" @onclick="ToggleIdiomaDropdown">
                                        <span class="toggle-text">@ObtenerResumenIdiomas()</span>
                                        <span class="toggle-arrow">▼</span>
                                    </div>
                                    @if (IsIdiomaDropdownOpen)
                                    {
                                        <div class="multiselect-dropdown">
                                            <div class="multiselect-item">
                                                <input id="chk-esp" class="multiselect-checkbox" type="checkbox" @bind="IdiomaEspSelected" @bind:after="ActualizarIdiomas" />
                                                <label for="chk-esp" class="multiselect-label">Español</label>
                                            </div>
                                            <div class="multiselect-item">
                                                <input id="chk-ing" class="multiselect-checkbox" type="checkbox" @bind="IdiomaIngSelected" @bind:after="ActualizarIdiomas" />
                                                <label for="chk-ing" class="multiselect-label">Inglés</label>
                                            </div>
                                            <div class="multiselect-item">
                                                <input id="chk-fra" class="multiselect-checkbox" type="checkbox" @bind="IdiomaFraSelected" @bind:after="ActualizarIdiomas" />
                                                <label for="chk-fra" class="multiselect-label">Francés</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            
                            <!-- Ciudad Destino -->
                            <div class="modal-group">
                                <label for="modal-ciudad">Ciudad destino</label>
                                <input id="modal-ciudad" class="modal-input" type="text" 
                                       @bind="FormServicio.CiudadDestino" required placeholder="Ej. Cusco" />
                            </div>
                            
                            <!-- Incluye Recojo -->
                            <div class="modal-group full-width">
                                <label for="modal-recojo">¿Incluye recojo?</label>
                                <select id="modal-recojo" class="modal-select" @bind="FormServicio.IncluyeRecojo" required>
                                    <option value="Sí">Sí</option>
                                    <option value="No">No</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
