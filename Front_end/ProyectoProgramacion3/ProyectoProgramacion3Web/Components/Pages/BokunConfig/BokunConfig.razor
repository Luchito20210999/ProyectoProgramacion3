@page "/bokun-config"
@namespace ProyectoProgramacion3Web.Components.Pages.BokunConfig

<PageTitle>Configuracion Bokun - SACR</PageTitle>

<div class="bokun-container">
    <div class="bokun-header">
        <div>
            <h1 class="bokun-title">Configuracion Bokun</h1>
            <p class="bokun-subtitle">Vista provisional para preparar RF16 sin exponer credenciales reales.</p>
        </div>
        <span class="status-chip">Provisional</span>
    </div>

    <section class="config-card">
        <div class="card-header">
            <h2>Parametros de integracion</h2>
            <p>Los valores sensibles se muestran enmascarados hasta definir el flujo final con el equipo.</p>
        </div>

        <div class="config-grid">
            <div class="config-field">
                <span class="field-label">Access Key</span>
                <span class="field-value">bk_live_************</span>
            </div>
            <div class="config-field">
                <span class="field-label">Secret Key</span>
                <span class="field-value">********************</span>
            </div>
            <div class="config-field">
                <span class="field-label">Webhook URL</span>
                <span class="field-value">/WebApplication/api/v1/bokun/webhook</span>
            </div>
            <div class="config-field">
                <span class="field-label">Validacion HMAC</span>
                <span class="field-value">Pendiente de validacion en despliegue</span>
            </div>
        </div>
    </section>

    <section class="config-card muted-card">
        <div class="card-header">
            <h2>Estado operativo</h2>
            <p>Esta pantalla no guarda cambios todavia. Solo reserva el lugar de administracion para RF16.</p>
        </div>

        <div class="status-list">
            <div class="status-row">
                <span>Endpoint Java configurado</span>
                <strong>Preparado</strong>
            </div>
            <div class="status-row">
                <span>Credenciales editables desde UI</span>
                <strong>Pendiente</strong>
            </div>
            <div class="status-row">
                <span>Ocultamiento de valores sensibles</span>
                <strong>Preparado</strong>
            </div>
        </div>
    </section>
</div>
