<!-- Created with Jaspersoft Studio version 7.0.6.final using JasperReports Library version 7.0.6-5d2a603fdc6b3db8f842a83383e594f41891534d  -->
<jasperReport name="Reporte_Ventas" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c399b8ca-8c19-4905-abf1-0ed480649e85">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="TAProyectoProgra3"/>
	<parameter name="P_FECHA_INICIO" class="java.util.Date"/>
	<parameter name="P_FECHA_FIN" class="java.util.Date"/>
	<parameter name="P_NOMBRE_SERVICIO" class="java.lang.String"/>
	<parameter name="P_CANAL" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT 
    r.id_reserva AS idReserva,
    CONCAT(c.nombres, ' ', c.apellidos) AS cliente,
    s.nombre AS servicio,
    DATE_FORMAT(r.fecha_registro, '%d/%m/%Y') AS fechaRecepcion,
    dr.cantidad AS pasajeros,
    dr.subtotal AS monto
FROM 
    Reserva r
    INNER JOIN Cliente c ON r.id_cliente = c.id_cliente
    INNER JOIN Detalle_Reserva dr ON r.id_reserva = dr.id_reserva
    INNER JOIN Servicio s ON dr.id_servicio = s.id_servicio
WHERE 
    r.fecha_registro BETWEEN $P{P_FECHA_INICIO} AND $P{P_FECHA_FIN}
    AND ($P{P_NOMBRE_SERVICIO} IS NULL OR $P{P_NOMBRE_SERVICIO} = '' OR s.nombre LIKE CONCAT('%', $P{P_NOMBRE_SERVICIO}, '%'))
    AND ($P{P_CANAL} IS NULL OR $P{P_CANAL} = '' OR r.canal_venta = $P{P_CANAL})
ORDER BY 
    r.fecha_registro ASC;]]></query>
	<field name="idReserva" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="id_reserva"/>
		<property name="com.jaspersoft.studio.field.label" value="idReserva"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="Reserva"/>
	</field>
	<field name="cliente" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="cliente"/>
		<property name="com.jaspersoft.studio.field.label" value="cliente"/>
	</field>
	<field name="servicio" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="nombre"/>
		<property name="com.jaspersoft.studio.field.label" value="servicio"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="Servicio"/>
	</field>
	<field name="fechaRecepcion" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="fechaRecepcion"/>
		<property name="com.jaspersoft.studio.field.label" value="fechaRecepcion"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="Reserva"/>
	</field>
	<field name="pasajeros" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="cantidad"/>
		<property name="com.jaspersoft.studio.field.label" value="pasajeros"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="Detalle_Reserva"/>
	</field>
	<field name="monto" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="subtotal"/>
		<property name="com.jaspersoft.studio.field.label" value="monto"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="Detalle_Reserva"/>
	</field>
	<variable name="MONTO_TOTAL" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{monto}.setScale( 2, java.math.RoundingMode.HALF_UP)]]></expression>
	</variable>
	<variable name="TOTAL_PASAJEROS" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[$F{pasajeros}]]></expression>
	</variable>
