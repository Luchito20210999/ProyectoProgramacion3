<!-- Created with Jaspersoft Studio version 7.0.6.final using JasperReports Library version 7.0.6-5d2a603fdc6b3db8f842a83383e594f41891534d  -->
<jasperReport name="Reporte_Calidad" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="aeb26fd9-2604-4225-9d5b-d8e1e5bb9905">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="TAProyectoProgra3"/>
	<parameter name="P_FECHA_INICIO" class="java.util.Date"/>
	<parameter name="P_FECHA_FIN" class="java.util.Date"/>
	<parameter name="P_NOMBRE_SERVICIO" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT 
    r.id_reserva AS idReserva,
    CONCAT(c.nombres, ' ', c.apellidos) AS cliente,
    GROUP_CONCAT(DISTINCT s.nombre SEPARATOR ', ') AS servicio,
    DATE_FORMAT(rec.fecha_reclamo, '%d/%m/%Y') AS fechaReclamo,
    rec.estado_reclamo AS estadoReclamo,
    rec.descripcion AS resolucion,
    
    kpi.total_reservas AS kpiTotalReservas,
    kpi.total_reclamos AS kpiTotalReclamos,
    IFNULL(ROUND((kpi.total_reclamos / NULLIF(kpi.total_reservas, 0)) * 100, 2), 0) AS kpiPorcentaje,
    kpi.cant_procede AS kpiProcede,
    kpi.cant_pendiente AS kpiPendiente,
    kpi.cant_en_atencion AS kpiEnAtencion,
    kpi.cant_no_procede AS kpiNoProcede
    
FROM Reclamo rec
INNER JOIN Reserva r ON rec.id_reserva = r.id_reserva
INNER JOIN Cliente c ON r.id_cliente = c.id_cliente
INNER JOIN Detalle_Reserva dr ON r.id_reserva = dr.id_reserva
INNER JOIN Servicio s ON dr.id_servicio = s.id_servicio
CROSS JOIN (
SELECT 
        (SELECT COUNT(DISTINCT r2.id_reserva)
         FROM Reserva r2
         INNER JOIN Detalle_Reserva dr2 ON r2.id_reserva = dr2.id_reserva
         INNER JOIN Servicio s2 ON dr2.id_servicio = s2.id_servicio
         WHERE DATE(r2.fecha_registro) BETWEEN $P{P_FECHA_INICIO} AND $P{P_FECHA_FIN}
           AND ($P{P_NOMBRE_SERVICIO} IS NULL OR $P{P_NOMBRE_SERVICIO} = '' OR s2.nombre LIKE CONCAT('%', $P{P_NOMBRE_SERVICIO}, '%'))) AS total_reservas,
        COUNT(DISTINCT rec2.id_reclamo) AS total_reclamos,
        SUM(CASE WHEN rec2.estado_reclamo = 'PROCEDE' THEN 1 ELSE 0 END) AS cant_procede,
        SUM(CASE WHEN rec2.estado_reclamo = 'PENDIENTE' THEN 1 ELSE 0 END) AS cant_pendiente,
        SUM(CASE WHEN rec2.estado_reclamo = 'EN_ATENCION' THEN 1 ELSE 0 END) AS cant_en_atencion,
        SUM(CASE WHEN rec2.estado_reclamo = 'NO_PROCEDE' THEN 1 ELSE 0 END) AS cant_no_procede
    FROM Reclamo rec2
    INNER JOIN Reserva r3 ON rec2.id_reserva = r3.id_reserva
    INNER JOIN Detalle_Reserva dr3 ON r3.id_reserva = dr3.id_reserva
    INNER JOIN Servicio s3 ON dr3.id_servicio = s3.id_servicio
    WHERE DATE(rec2.fecha_reclamo) BETWEEN $P{P_FECHA_INICIO} AND $P{P_FECHA_FIN}
      AND ($P{P_NOMBRE_SERVICIO} IS NULL OR $P{P_NOMBRE_SERVICIO} = '' OR s3.nombre LIKE CONCAT('%', $P{P_NOMBRE_SERVICIO}, '%'))
) AS kpi
WHERE DATE(rec.fecha_reclamo) BETWEEN $P{P_FECHA_INICIO} AND $P{P_FECHA_FIN}
AND ($P{P_NOMBRE_SERVICIO} IS NULL OR $P{P_NOMBRE_SERVICIO} = '' OR s.nombre LIKE CONCAT('%', $P{P_NOMBRE_SERVICIO}, '%'))
GROUP BY 
    rec.id_reclamo, r.id_reserva, c.nombres, c.apellidos, 
    rec.fecha_reclamo, rec.estado_reclamo, rec.descripcion,
    kpi.total_reservas, kpi.total_reclamos, kpi.cant_procede, 
    kpi.cant_pendiente, kpi.cant_en_atencion, kpi.cant_no_procede
ORDER BY rec.fecha_reclamo ASC;]]></query>
