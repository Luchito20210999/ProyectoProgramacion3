@page "/usuarios"
@namespace ProyectoProgramacion3Web.Components.Pages.Usuarios

<PageTitle>Gestión de Usuarios - SACR</PageTitle>

<div class="usuarios-container">
    <!-- Encabezado de la página -->
    <div class="usuarios-header">
        <div class="header-titles">
            <h1 class="usuarios-title">Gestión de Usuarios</h1>
            <p class="usuarios-subtitle">Administra cuentas, roles y permisos.</p>
        </div>
        <div class="header-actions">
            <!-- Botón principal (Nuevo usuario) -->
            <button class="btn btn-primary" @onclick="AbrirModalNuevo">
                <span class="btn-icon">＋</span> Nuevo usuario
            </button>
        </div>
    </div>
    
    <!-- Barra de herramientas (Filtro y Exportación) -->
    <div class="tools-card">
        <div class="tools-bar">
            <!-- Filtro por tipo de usuario -->
            <div class="filter-control-wrapper">
                <select class="select-filter" @bind="FiltroTipo" @bind:after="FiltrarListado">
                    <option value="Todos los tipos">Todos los tipos</option>
                    <option value="Administrador">Administrador</option>
                    <option value="Analista">Analista</option>
                    <option value="Operador">Operador</option>
                </select>
            </div>
            
            <!-- Espacio flexible -->
            <div class="tools-flex"></div>
            
            <!-- Botón secundario discreto (Exportar) -->
            <button class="btn btn-export" @onclick="ExportarListado">
                <span class="btn-icon">⤓</span> Exportar
            </button>
        </div>
    </div>
    
    <!-- Tarjeta de la Tabla principal -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 60px;">N°</th>
                        <th>Nombre</th>
                        <th style="width: 100px;">Tipo doc.</th>
                        <th>N° doc.</th>
                        <th>Correo</th>
                        <th>Tipo</th>
                        <th class="text-center" style="width: 120px;">Estado</th>
                        <th class="text-center" style="width: 160px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ListadoFiltrado != null && ListadoFiltrado.Any())
                    {
                        var correlative = 1;
                        @foreach (var u in ListadoFiltrado)
                        {
                            <tr>
                                <td class="text-center font-mono text-muted">@correlative</td>
                                <td class="client-name">@u.NombreCompleto</td>
                                <td class="font-bold">@u.TipoDocumento</td>
                                <td class="font-mono">@u.NumeroDocumento</td>
                                <td class="email-text">@u.Correo</td>
                                <td class="role-text">@u.Tipo</td>
                                <td class="text-center">
                                    <span class="status-pill @u.EstadoClase">@u.Estado</span>
                                </td>
                                <td class="text-center">
                                    <div class="row-actions">
                                        <button class="btn-row btn-row-edit" @onclick="() => AbrirModalEditar(u)">Editar</button>
                                        <button class="btn-row btn-row-delete" @onclick="() => SolicitarEliminar(u)">Eliminar</button>
                                    </div>
                                </td>
                            </tr>
                            correlative++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-12">
                                <div style="font-size: 3rem; margin-bottom: 0.5rem;">👥</div>
                                <h3 style="font-size: 1.25rem; font-weight: 700; color: #0f172a; margin: 0 0 0.25rem 0;">No se encontraron usuarios.</h3>
                                <p style="color: #64748b; margin: 0; font-size: 0.9rem;">No hay cuentas que coincidan con el filtro seleccionado.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Modal emergente para Crear / Editar Usuario -->
    @if (IsFormModalOpen)
    {
        <div class="modal-backdrop">
            <div class="modal-window">
                <div class="modal-header">
                    <h2>@ModalTitle</h2>
                    <button class="modal-close-btn" @onclick="CerrarFormModal">×</button>
                </div>
                
                <div class="modal-body">
                    <!-- Caja de alerta de errores -->
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert-error-box">
                            <span class="alert-icon">⚠️</span>
                            <span class="alert-text">@ErrorMessage</span>
                        </div>
                    }
                    
                    <form @onsubmit="GuardarUsuario" @onsubmit:preventDefault>
                        <div class="modal-grid">
                            <!-- Nombres -->
                            <div class="modal-group">
                                <label for="form-nombres">Nombres <span class="required-asterisk">*</span></label>
                                <input id="form-nombres" class="modal-input" type="text" @bind="FormUsuario.Nombres" required placeholder="Nombres del usuario" />
                            </div>
                            
                            <!-- Apellidos -->
                            <div class="modal-group">
                                <label for="form-apellidos">Apellidos <span class="required-asterisk">*</span></label>
                                <input id="form-apellidos" class="modal-input" type="text" @bind="FormUsuario.Apellidos" required placeholder="Apellidos del usuario" />
                            </div>
                            
                            <!-- Tipo de Documento -->
                            <div class="modal-group">
                                <label for="form-tipodoc">Tipo de documento</label>
                                <select id="form-tipodoc" class="modal-select" @bind="FormUsuario.TipoDocumento">
                                    <option value="DNI">DNI</option>
                                    <option value="PASAPORTE">PASAPORTE</option>
                                    <option value="CE">CE</option>
                                </select>
                            </div>
                            
                            <!-- Número de Documento -->
                            <div class="modal-group">
                                <label for="form-numdoc">Número de documento</label>
                                <input id="form-numdoc" class="modal-input" type="text" @bind="FormUsuario.NumeroDocumento" placeholder="N° de identificación" />
                            </div>
                            
                            <!-- Correo -->
                            <div class="modal-group">
                                <label for="form-correo">Correo <span class="required-asterisk">*</span></label>
                                <input id="form-correo" class="modal-input" type="email" @bind="FormUsuario.Correo" required placeholder="nombre.apellido@sacr.pe" />
                            </div>
                            
                            <!-- Teléfono -->
                            <div class="modal-group">
                                <label for="form-telefono">Teléfono</label>
                                <input id="form-telefono" class="modal-input" type="text" @bind="FormUsuario.Telefono" placeholder="Ej. 998877665" />
                            </div>
                            
                            <!-- Tipo de Usuario -->
                            <div class="modal-group">
                                <label for="form-tipo">Tipo de usuario</label>
                                <select id="form-tipo" class="modal-select" @bind="FormUsuario.Tipo">
                                    <option value="Administrador">Administrador</option>
                                    <option value="Analista">Analista</option>
                                    <option value="Operador">Operador</option>
                                </select>
                            </div>
                            
                            <!-- Estado -->
                            <div class="modal-group">
                                <label for="form-estado">Estado</label>
                                <select id="form-estado" class="modal-select" @bind="FormUsuario.Estado">
                                    <option value="Activo">Activo</option>
                                    <option value="Inactivo">Inactivo</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="modal-footer">
                            <button type="button" class="btn btn-cancel" @onclick="CerrarFormModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    
    <!-- Modal emergente para Confirmar Eliminación (Peligro, Rojo) -->
    @if (IsDeleteModalOpen && UsuarioAEliminar != null)
    {
        <div class="modal-backdrop">
            <div class="modal-window delete-confirm-window">
                <div class="modal-header delete-confirm-header">
                    <h2>Confirmar eliminación</h2>
                    <button class="modal-close-btn text-white" @onclick="CerrarDeleteModal">×</button>
                </div>
                
                <div class="modal-body delete-confirm-body">
                    <div class="delete-icon-wrapper">🗑️</div>
                    <h3>¿Eliminar cuenta de usuario?</h3>
                    <p class="delete-warning-text">
                        Esta acción es irreversible. Se eliminará de forma permanente el acceso y registro del usuario 
                        <strong>@UsuarioAEliminar.NombreCompleto</strong> (@UsuarioAEliminar.Correo) del sistema.
                    </p>
                    
                    <div class="modal-footer delete-confirm-footer">
                        <button type="button" class="btn btn-cancel" @onclick="CerrarDeleteModal">Cancelar</button>
                        <button type="button" class="btn btn-danger" @onclick="EliminarUsuarioConfirmado">Eliminar cuenta</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
