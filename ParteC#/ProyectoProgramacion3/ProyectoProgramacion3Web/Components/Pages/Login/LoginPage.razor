@page "/"
@page "/Login"
@layout EmptyLayout

<div class="auth-wrap">
    <aside class="auth-hero">
        <div class="auth-hero-header">
            <div class="auth-logo">
                <div class="auth-logo-icon">S</div>
                SACR
            </div>
        </div>
        <div class="auth-hero-content">
            <h2>Sistema de Atención<br />de Clientes y Reservas</h2>
            <p>Gestiona reservas Bokun, atiende reclamos y monitorea la calidad de tus servicios turísticos en un solo lugar.</p>
        </div>
        <small class="auth-footer">© 2026 PUCP – SACR</small>
    </aside>
    <section class="auth-form-wrap">
        <form class="auth-form" @onsubmit="HandleLogin" @onsubmit:preventDefault>
            <h1>Bienvenido</h1>
            <p class="muted">Ingresa tus credenciales para continuar</p>
            
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div style="color: #ef4444; background: #fee2e2; padding: 0.75rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.875rem;">
                    @ErrorMessage
                </div>
            }
            
            <div class="form-group">
                <label for="email">Correo electrónico</label>
                <input id="email" class="input" type="email" placeholder="usuario@empresa.com" required @bind="Email" />
            </div>
            
            <div class="form-group">
                <label for="password">Contraseña</label>
                <input id="password" class="input" type="password" placeholder="••••••••" required @bind="Password" />
            </div>
            
            <div class="form-options">
                <label class="remember-me">
                    <input type="checkbox" /> Recordarme
                </label>
                <a href="#" class="forgot-password">¿Olvidaste tu contraseña?</a>
            </div>
            
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Iniciar sesión</button>
        </form>
    </section>
</div>
