@page "/reservas"
@namespace ProyectoProgramacion3Web.Components.Pages.Reservas

<PageTitle>Gestión de Reservas - SACR</PageTitle>

<div class="reservas-container">
    <!-- Título y Encabezado -->
    <div class="reservas-header">
        <div class="header-titles">
            <h1 class="reservas-title">Gestión de Reservas</h1>
            <p class="reservas-subtitle">Reservas sincronizadas desde Bokun y registradas manualmente.</p>
        </div>
        <div class="header-actions">
            <button class="btn btn-secondary" @onclick="SincronizarBokun">
                <span class="btn-icon">🔄</span> Sincronizar Bokun
            </button>
            <button class="btn btn-primary" @onclick='() => AbrirModal("Nuevo")'>
                <span class="btn-icon">＋</span> Nueva reserva
            </button>
        </div>
    </div>
    
    <!-- Bloques de métricas (KPIs) -->
    <div class="metrics-grid">
        <div class="metric-card">
            <span class="metric-label">Total</span>
            <span class="metric-value">@TotalCount</span>
        </div>
        
        <div class="metric-card">
            <span class="metric-label">Confirmadas</span>
            <span class="metric-value">@ConfirmadasCount</span>
        </div>
        
        <div class="metric-card">
            <span class="metric-label">Pendientes</span>
            <span class="metric-value">@PendientesCount</span>
        </div>
        
        <div class="metric-card">
            <span class="metric-label">Anuladas</span>
            <span class="metric-value">@AnuladasCount</span>
        </div>
    </div>
    
    <!-- Barra de filtros -->
    <div class="filters-card">
        <div class="filters-bar">
            <!-- Buscar por texto -->
            <div class="filter-control search-input-wrapper">
                <span class="search-icon">🔍</span>
                <input class="input-filter" type="text" placeholder="Buscar por código, cliente o servicio..." 
                       @bind="SearchText" @bind:event="oninput" @onkeyup="FiltrarListado" />
            </div>
            
            <!-- Selector de estado -->
            <div class="filter-control">
                <select class="select-filter" @bind="SelectedEstado" @bind:after="FiltrarListado">
                    <option value="TODOS">Todos los estados</option>
                    <option value="CONFIRMADA">CONFIRMADA</option>
                    <option value="PENDIENTE">PENDIENTE</option>
                    <option value="ANULADA">ANULADA</option>
                </select>
            </div>
            
            <!-- Filtro de fecha -->
            <div class="filter-control">
                <input class="date-filter" type="date" @bind="SelectedFecha" @bind:after="FiltrarListado" />
            </div>
            
            <!-- Espacio flexible -->
            <div class="filter-flex"></div>
            
            <!-- Limpiar filtros -->
            @if (!string.IsNullOrEmpty(SearchText) || SelectedEstado != "TODOS" || SelectedFecha.HasValue)
            {
                <button class="btn-clear" @onclick="LimpiarFiltros">Limpiar filtros</button>
            }
        </div>
    </div>
    
    <!-- Tabla principal de reservas -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Cliente</th>
                        <th>Servicio</th>
                        <th>Fecha servicio</th>
                        <th class="text-center">Pax</th>
                        <th class="text-right">Monto</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ListadoFiltrado != null && ListadoFiltrado.Any())
                    {
                        @foreach (var res in ListadoFiltrado)
                        {
                            <tr>
                                <td class="font-mono text-primary font-bold">@res.Codigo</td>
                                <td class="font-semibold">@res.Cliente</td>
                                <td>@res.Servicio</td>
                                <td>@res.FechaServicio.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">@res.Pax</td>
                                <td class="text-right font-semibold">$@res.Monto.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="status-pill @res.EstadoClase">@res.Estado</span>
                                </td>
                                <td class="text-center">
                                    <div class="row-actions">
                                        <button class="btn-row btn-row-view" @onclick='() => AbrirModal("Ver", res)'>Ver</button>
                                        @if (res.Estado != "Anulada")
                                        {
                                            <button class="btn-row btn-row-edit" @onclick='() => AbrirModal("Modificar", res)'>Modificar</button>
                                            <button class="btn-row btn-row-cancel" @onclick="() => AnularReserva(res)">Anular</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-8">
                                <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🔍</div>
                                No se encontraron reservas que coincidan con los filtros seleccionados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Modal emergente para CRUD -->
    @if (IsModalOpen)
    {
        <div class="modal-backdrop">
            <div class="modal-window">
                <div class="modal-header">
                    <h2>@ModalTitle</h2>
                    <button class="modal-close-btn" @onclick="CerrarModal">×</button>
                </div>
                
                <div class="modal-body">
                    <form @onsubmit="GuardarReserva" @onsubmit:preventDefault>
                        <div class="modal-grid">
                            <!-- Código -->
                            <div class="modal-group">
                                <label for="modal-codigo">Código Bokun</label>
                                <input id="modal-codigo" class="modal-input" type="text" 
                                       @bind="FormReserva.Codigo" disabled="@IsCodigoReadOnly" required />
                            </div>
                            
                            <!-- Servicio -->
                            <div class="modal-group">
                                <label for="modal-servicio">Servicio turístico</label>
                                <input id="modal-servicio" class="modal-input" type="text" 
                                       @bind="FormReserva.Servicio" disabled="@IsFormDisabled" required />
                            </div>
                            
                            <!-- Cliente -->
                            <div class="modal-group">
                                <label for="modal-cliente">Cliente</label>
                                <input id="modal-cliente" class="modal-input" type="text" 
                                       @bind="FormReserva.Cliente" disabled="@IsFormDisabled" required />
                            </div>
                            
                            <!-- Pax -->
                            <div class="modal-group">
                                <label for="modal-pax">Pax (Pasajeros)</label>
                                <input id="modal-pax" class="modal-input" type="number" min="1" 
                                       @bind="FormReserva.Pax" disabled="@IsFormDisabled" required />
                            </div>
                            
                            <!-- Fecha de Servicio -->
                            <div class="modal-group">
                                <label for="modal-fecha">Fecha del servicio</label>
                                <input id="modal-fecha" class="modal-input" type="date" 
                                       @bind="FormReserva.FechaServicio" @bind:format="yyyy-MM-dd" disabled="@IsFormDisabled" required />
                            </div>
                            
                            <!-- Monto -->
                            <div class="modal-group">
                                <label for="modal-monto">Monto (USD)</label>
                                <input id="modal-monto" class="modal-input" type="number" step="0.01" 
                                       @bind="FormReserva.Monto" disabled="@IsFormDisabled" required />
                            </div>
                            
                            <!-- Estado -->
                            <div class="modal-group full-width">
                                <label for="modal-estado">Estado de Reserva</label>
                                <select id="modal-estado" class="modal-select" 
                                        @bind="FormReserva.Estado" disabled="@IsFormDisabled">
                                    <option value="Confirmada">Confirmada</option>
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="Anulada">Anulada</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                            @if (ShowGuardarBtn)
                            {
                                <button type="submit" class="btn btn-primary">Guardar</button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
