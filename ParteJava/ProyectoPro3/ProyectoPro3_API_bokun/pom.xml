<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pe.edu.pucp.proyectopro3</groupId>
        <artifactId>ProyectoPro3</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ProyectoPro3_API_bokun</artifactId>
    <packaging>war</packaging>
    <name>ProyectoPro3_API_bokun</name>

    <properties>
        <jersey.version>3.1.8</jersey.version>
        <junit.version>5.13.2</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>pe.edu.pucp.proyectopro3</groupId>
            <artifactId>ProyectoPro3Negocio</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- DBManager: necesario para que el WAR resuelva db.properties y conecte a la BD -->
        <dependency>
            <groupId>pe.edu.pucp.proyectopro3</groupId>
            <artifactId>ProyectoPro3DBManager</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Driver MySQL: necesario en el WAR para la conexión JDBC en runtime -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.4.0</version>
        </dependency>

        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- GlassFish 8 ya incluye Jersey internamente.
             Marcamos como 'provided' para que no se empaqueten en el WAR
             y evitar el conflicto de classloader que causa el 404. -->
        <dependency>
            <groupId>org.glassfish.jersey.containers</groupId>
            <artifactId>jersey-container-servlet</artifactId>
            <version>${jersey.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.inject</groupId>
            <artifactId>jersey-hk2</artifactId>
            <version>${jersey.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-json-jackson</artifactId>
            <version>${jersey.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
        </plugins>
    </build>
</project>
